# Copier ce fichier en .env et renseigner les vraies valeurs. Ne jamais committer .env.

# --- PostgreSQL / PostGIS ---
POSTGRES_USER=urbanflow
POSTGRES_PASSWORD=changeme
POSTGRES_DB=urbanflow
DATABASE_URL=postgresql://urbanflow:changeme@db:5432/urbanflow

# --- Valkey (cache) ---
CACHE_URL=redis://cache:6379

# --- Auth (Phase 4) ---
JWT_SECRET=changeme
JWT_REFRESH_SECRET=changeme
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
WEB_ORIGIN=http://localhost:3000
# URL interne (reseau Docker) que les Route Handlers Next.js (BFF) utilisent
# pour relayer vers NestJS — jamais exposee au client.
API_INTERNAL_URL=http://api:3000/api/v1

# --- Intégrations externes (Phase 5) ---
TISSEO_API_KEY=
TISSEO_GTFS_RT_URL=https://api.tisseo.fr/opendata/gtfsrt/GtfsRt.pb
GBFS_VELOTOULOUSE_URL=https://api.cyclocity.fr/contracts/toulouse/gbfs/gbfs.json
GBFS_YEGO_URL=https://services.rideyego.com/gbfs/2-2/toulouse/fr/gbfs

# --- OpenTripPlanner (Phase 3) ---
OTP_URL=http://otp:8080/otp/routers/default

# --- Web Push (Phase 8) — generer avec `npx web-push generate-vapid-keys` ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@example.com

# --- Observabilité (Phase 12) ---
# API (NestJS) — apps/api/src/instrument.ts.
SENTRY_DSN=
# Web (Next.js) — NEXT_PUBLIC_* car inline dans le bundle navigateur ; un DSN
# Sentry n'est pas un secret (permet seulement d'envoyer des evenements).
NEXT_PUBLIC_SENTRY_DSN=
# Optionnels, upload des source maps au build uniquement (apps/web/next.config.ts) —
# sans effet sur le fonctionnement de l'app si absents.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

NODE_ENV=development
