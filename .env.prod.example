# Modele du .env a deposer sur le VPS (a cote de docker-compose.prod.yml,
# jamais commite) — voir infra/docker-compose.prod.yml et infra/Caddyfile.
# Toutes les valeurs "changeme" doivent etre remplacees par de vrais
# secrets generes pour la prod, distincts de ceux utilises en dev.

# --- PostgreSQL / PostGIS ---
POSTGRES_USER=urbanflow
POSTGRES_PASSWORD=changeme
POSTGRES_DB=urbanflow
DATABASE_URL=postgresql://urbanflow:changeme@db:5432/urbanflow

# --- Valkey (cache) ---
CACHE_URL=redis://cache:6379

# --- Auth ---
# Generer avec `openssl rand -base64 48` (deux valeurs distinctes).
JWT_SECRET=changeme
JWT_REFRESH_SECRET=changeme
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
WEB_ORIGIN=https://votre-domaine.example
# URL interne (reseau Docker) — le nom de service reste "api" en prod
# comme en dev, seule l'adresse jamais publiee change de sens.
API_INTERNAL_URL=http://api:3000/api/v1

# --- Intégrations externes ---
TISSEO_API_KEY=
TISSEO_GTFS_RT_URL=https://api.tisseo.fr/opendata/gtfsrt/GtfsRt.pb
GBFS_VELOTOULOUSE_URL=https://api.cyclocity.fr/contracts/toulouse/gbfs/gbfs.json
GBFS_YEGO_URL=https://services.rideyego.com/gbfs/2-2/toulouse/fr/gbfs

# --- OpenTripPlanner ---
OTP_URL=http://otp:8080/otp/routers/default

# --- Web Push — generer avec `npx web-push generate-vapid-keys` ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@votre-domaine.example

# --- Observabilité ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Optionnels, upload des source maps au build uniquement — sans effet sur le
# fonctionnement de l'app si absents.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Déploiement (Phase 12) ---
# Nom de domaine pointant sur l'IP du VPS (enregistrement DNS A/AAAA a
# faire chez le registrar avant le premier demarrage de Caddy).
DOMAIN=votre-domaine.example
# Adresse de contact pour Let's Encrypt (expiration de certificat, abus).
ACME_EMAIL=contact@votre-domaine.example

NODE_ENV=production
